# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
# Use the service role key (not the anon key) because sync performs writes.
# Set SUPABASE_SERVICE_ROLE_KEY in your local .env; never commit it.
SUPABASE_SCHEMA=star_vault

# Embeddings: same OpenRouter route as Tweet Vault.
# Set OPENROUTER_API_KEY in your local .env; never commit it.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_PROVIDER=openrouter

# Optional direct OpenAI fallback.
# Set OPENAI_API_KEY in your local .env when EMBEDDING_PROVIDER=openai.

# Optional Gemini provider.
# EMBEDDING_PROVIDER=gemini
# Set GEMINI_API_KEY or GOOGLE_API_KEY in your local .env when selected.

# Optional: content is rechecked when last checked >= this many days ago.
# CONTENT_STALE_DAYS=30

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes:
# - public stars: read:user
# - private repos stars/content (if needed): repo
# Set GITHUB_TOKEN in your local .env; never commit it.
